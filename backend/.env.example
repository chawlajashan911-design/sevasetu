# SevaSetu Backend Environment Configuration

# Application
APP_ENV=development
APP_PORT=8000
DEBUG=True

# Database
DATABASE_URL=sqlite:///./rural_healthcare.db

# CORS Allowed Origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# BHASHINI API Credentials (National Language Translation Mission)
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_PIPELINE_ID=
BHASHINI_INFERENCE_URL=https://dhruva-api.bhashini.gov.in/services/inference/pipeline

# ABDM Sandbox Credentials (Ayushman Bharat Digital Mission)
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
ABDM_GATEWAY_URL=https://dev.abdm.gov.in/gateway

# eSanjeevani Teleconsultation Configuration
ESANJEEVANI_JITSI_DOMAIN=meet.jit.si
